{
  "$comment": "File: charts/tasktracker/values.schema.json | Assignment: DSO202 Assignment 4 | Descriptor: Unit III 3.2 - chart validation | Purpose: helm lint, helm template and Argo CD's repo server reject values that break the chart contract: an unpinned or floating image tag (design rule 3), a missing existingSecret (C3), a NodePort outside the Kubernetes range (C10), or a container without requests and limits (C7).",
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "existingSecret", "database", "backend", "frontend"],
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "enum": ["latest", "stable", "master", "HEAD"] }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  },
  "properties": {
    "environment": { "type": "string" },
    "existingSecret": { "type": "string" },
    "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "imagePullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] },
    "database": {
      "type": "object",
      "required": ["image", "resources"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "config": { "$ref": "#/definitions/config" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "backend": {
      "type": "object",
      "required": ["image", "resources"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "config": { "$ref": "#/definitions/config" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["image", "resources", "service", "apiUpstream"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "config": { "$ref": "#/definitions/config" },
        "apiUpstream": { "type": "string", "pattern": "^https?://" },
        "resources": { "$ref": "#/definitions/resources" },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
